#!/usr/bin/env bash
set -uo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: $0 <command> [args...]" >&2
  exit 2
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
log_dir="$root/.codex-logs"
mkdir -p "$log_dir"

stamp="$(date +%Y%m%d-%H%M%S)"
safe_name="$(printf '%s' "$1" | tr -cs 'A-Za-z0-9._-' '_')"
log="$log_dir/${stamp}-${safe_name}.log"

start="$(date +%s)"
set +e
"$@" >"$log" 2>&1
status=$?
set -e
duration=$(( $(date +%s) - start ))

clean="$(mktemp)"
trap 'rm -f "$clean"' EXIT

sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g' "$log" 2>/dev/null \
  | awk '
      /NO_COLOR.*FORCE_COLOR/ { next }
      /node --trace-warnings/ { next }
      length($0) > 1200 { printf("[omitted long line: %d chars]\\n", length($0)); next }
      { print }
    ' >"$clean" || cp "$log" "$clean"

printf 'status: %d\n' "$status"
printf 'duration_s: %d\n' "$duration"
printf 'log_lines: %s\n' "$(wc -l < "$clean" | tr -d ' ')"
printf 'log_bytes: %s\n' "$(wc -c < "$log" | tr -d ' ')"
printf 'full_log: %s\n' "${log#$root/}"

if [[ $status -eq 0 ]]; then
  echo "--- summary ---"
  summary=""
  if command -v rg >/dev/null 2>&1; then
    summary="$(rg -n -i -m 30 \
      '(^|[^a-z])(pass|passed|success|successful|complete|completed|tests?|suites?|FINAL_CHECK|PUBLISH|WORKFLOW_CHECK|BUILD)([^a-z]|$)' \
      "$clean" 2>/dev/null | tail -n 10 || true)"
  fi
  if [[ -n "$summary" ]]; then
    printf '%s\n' "$summary"
  else
    tail -n 8 "$clean"
  fi
else
  echo "--- diagnostics ---"
  if command -v rg >/dev/null 2>&1; then
    rg -n -i -m 30 \
      'error context:|test-failed|trace\.zip|(^|[^a-z])(error|failed|failure|exception|fatal|assert|expected|received|timeout|TS[0-9]{4})([^a-z]|$)' \
      "$clean" || true
  else
    grep -Ein -m 30 \
      'error context:|test-failed|trace\.zip|error|failed|failure|exception|fatal|assert|expected|received|timeout|TS[0-9]{4}' \
      "$clean" || true
  fi
  echo "--- final 12 lines ---"
  tail -n 12 "$clean"
  echo "--- next ---"
  echo "Use: scripts/pd-log ${log#$root/} [pattern]"
fi

exit "$status"
